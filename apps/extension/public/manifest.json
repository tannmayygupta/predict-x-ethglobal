{
  "manifest_version": 3,
  "name": "Predictx",
  "version": "0.1.0",
  "description": "Token intelligence, market previews, and prediction markets on X.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "action": { "default_title": "Open Predictx" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["content.css", "logo.svg"], "matches": ["https://x.com/*", "https://twitter.com/*"] }
  ]
}


