# Backend image (Fastify API). Built from the repo root so the workspace packages are available.
# Secrets are NOT baked in: no ARG/ENV here carries a key. The host injects them at run time.
FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

# Every workspace manifest is copied so `--frozen-lockfile` sees the same workspace the lockfile was made from;
# only the backend and what it depends on (packages/shared) are actually installed.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY apps/extension/package.json apps/extension/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile --filter @predictx/backend...

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/backend apps/backend

WORKDIR /app/apps/backend

# Vercel routes container functions to port 80 by default and expects the server on 0.0.0.0 (the backend already does).
# An in-memory SQLite is enough while Flash orders are off: it only caches AI answers and unused quotes.
ENV NODE_ENV=production \
    PORT=80 \
    SQLITE_PATH=:memory:

USER node
EXPOSE 80

# tsx runs the TypeScript directly (the workspace package is consumed as source). Running the binary, not
# `pnpm start`, keeps node as PID 1 so it receives SIGTERM and shuts down cleanly.
CMD ["node_modules/.bin/tsx", "src/server.ts"]
