# Settlement worker: polls Base Sepolia for pools past their close time and runs the Chainlink CRE workflow
# (`cre workflow simulate --broadcast`) to deliver the result on-chain. No web server, no inbound traffic.
# This is a CRE SIMULATION with real on-chain delivery; it is labelled that way everywhere it is shown.
FROM oven/bun:1.4.4 AS bun

FROM node:22-bookworm-slim

# pipefail so a failed download in `curl | bash` fails the build instead of silently installing nothing
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# curl, gpg and tar are what Chainlink's installer needs (it verifies a signature on the binary with gpg)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg tar \
    && rm -rf /var/lib/apt/lists/*

# Bun compiles the workflow. 1.4.4 is the version that wrote cre/resolve-pools/bun.lock (older Bun cannot parse it)
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

# The cre CLI, pinned to v1.39.0 (the version the workflow was simulated with). Chainlink's install.sh is NOT used:
# it always calls GitHub's API, which rate-limits shared build IPs (HTTP 403). Instead the release file is fetched
# directly and its signature is verified with Chainlink's public key (taken from their installer) against a pinned
# fingerprint. The "_ldd2-35" build is used on purpose: the default Linux build needs glibc 2.38, bookworm has 2.36.
RUN set -eux; \
    base=https://github.com/smartcontractkit/cre-cli/releases/download/v1.39.0; \
    mkdir /tmp/cre; cd /tmp/cre; \
    curl -fsSL -o cre.tar.gz "$base/cre_linux_amd64_ldd2-35.tar.gz"; \
    curl -fsSL -o cre.sig "$base/cre_linux_amd64_ldd2-35.sig"; \
    curl -fsSL -o install.sh https://app.chain.link/cre/install.sh; \
    sed -n '/-----BEGIN PGP PUBLIC KEY BLOCK-----/,/-----END PGP PUBLIC KEY BLOCK-----/p' install.sh | sed 's/^[[:space:]]*//' > key.asc; \
    gpg --batch --import key.asc; \
    tar -xzf cre.tar.gz; \
    gpg --batch --status-fd=1 --verify cre.sig cre_v1.39.0_linux_amd64 | grep -q "VALIDSIG 82449102CBB89ED9BEE11A484645BC1404C2F3DD"; \
    install -m 0755 cre_v1.39.0_linux_amd64 /usr/local/bin/cre; \
    cd /; rm -rf /tmp/cre /root/.gnupg; \
    cre version

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY apps/extension/package.json apps/extension/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
# The loop script resolves viem through apps/backend/node_modules (see scripts/tsconfig.json), so the backend's
# dependencies are installed; nothing else from the workspace is needed.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @predictx/backend...

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY scripts scripts
COPY cre cre
# The workflow lives outside the pnpm workspace and has its own lockfile
RUN cd cre/resolve-pools && bun install --frozen-lockfile

# The cre CLI and Bun write caches and build output (home directory, the workflow folder), so run as a user that owns them
RUN chown -R node:node /app/cre
USER node
ENV HOME=/home/node \
    NODE_ENV=production

WORKDIR /app/apps/backend

# Secrets arrive as environment variables at run time: CRE_LOGIN_YAML_B64 (your saved cre login, restored by settler-start.mjs; or CRE_API_KEY), CRE_ETH_PRIVATE_KEY
# (a throwaway Base Sepolia wallet that pays gas), CRE_COINGECKO_API_KEY. POOL_RPC_URL is optional.
CMD ["node_modules/.bin/tsx", "--tsconfig", "../../scripts/tsconfig.json", "../../scripts/settler-start.mjs"]
