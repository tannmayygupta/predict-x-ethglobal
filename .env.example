# Base Sepolia deployment (2026-10-31): PredictionPool 0x6b0f6C0f324C615Add6BfcA5EE0b8eeD66F2C0cd, MockUSDC 0x1e05373c199D764f7dE0353d58AFEa2b4C6326Ef
# ---- Extension / dashboard (Part A) ----
# Dashboard dev server. On Vercel set these in the project settings instead:
#   VITE_API_BASE_URL=/api/v1   VITE_DASHBOARD_URL=https://predictx-tawny.vercel.app
# Use the public production alias, NOT <project>-<team>.vercel.app: that one is behind Vercel Authentication.
VITE_API_BASE_URL=http://localhost:8787/api/v1
VITE_DASHBOARD_URL=http://localhost:5173
# Extension build only (the extension does not read the two lines above). Leave both unset and it targets the deployed
# app, https://predictx-tawny.vercel.app, which is what the link in a post must point at. Uncomment BOTH only for a build
# against your own backend and dashboard, and never post from that build. `pnpm demo` sets them for its own build.
# VITE_EXTENSION_API_BASE_URL=http://localhost:8787/api/v1
# VITE_EXTENSION_DASHBOARD_URL=http://localhost:5173
VITE_POOL_CHAIN_ID=84532
VITE_POOL_ADDRESS=0x6b0f6C0f324C615Add6BfcA5EE0b8eeD66F2C0cd
VITE_USDC_ADDRESS=0x1e05373c199D764f7dE0353d58AFEa2b4C6326Ef
VITE_POOL_RPC_URL=https://sepolia.base.org

# ---- Backend (Part B) ----
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,https://x.com
FLASH_API_KEY=
FLASH_BASE_URL=https://flash.definitive.fi/v1
FLASH_MOCK=true
# Real Flash orders spend Base MAINNET funds. Keep false unless you deliberately want to submit orders (quotes always work).
FLASH_ORDERS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
COINGECKO_API_KEY=
POOL_CHAIN_ID=84532
POOL_ADDRESS=0x6b0f6C0f324C615Add6BfcA5EE0b8eeD66F2C0cd
POOL_RPC_URL=https://sepolia.base.org
SQLITE_PATH=./predictx.sqlite
# Hosted (Vercel): https://predictx-tawny.vercel.app, the public alias. It feeds pool.dashboardUrl, so a protected alias here puts a login wall behind every shared pool link.
DASHBOARD_URL=http://localhost:5173
LOG_LEVEL=info
# false locally; a hop count behind a proxy (1 on Railway/Render). "true" is rejected: it lets clients spoof their IP.
TRUST_PROXY=false
VALIDATE_RESPONSES=true

# ---- Gate 0 script (scripts/gate0-flash.ts, human only) ----
GATE0_PRIVATE_KEY=
GATE0_RPC_URL=https://mainnet.base.org
GATE0_AMOUNT_USDC=1.00

# ---- Resolver loop + end-to-end test (scripts/, throwaway Base Sepolia keys only, never a real wallet) ----
# Pays gas for the CRE simulation broadcast (64 hex chars, with or without 0x)
CRE_ETH_PRIVATE_KEY=
# Login for the cre CLI: run `cre login` once, or set an API key here so the loop can run unattended
CRE_API_KEY=
RESOLVER_INTERVAL_SECONDS=60
# Two funded Base Sepolia wallets for scripts/e2e-lifecycle.ts and the live tests (A creates and bets YES, B bets NO)
TEST_WALLET_A_PRIVATE_KEY=
TEST_WALLET_B_PRIVATE_KEY=

# ---- CRE (Part B) ----
CRE_POOL_ADDRESS=0x6b0f6C0f324C615Add6BfcA5EE0b8eeD66F2C0cd
CRE_POOL_CHAIN_SELECTOR=10344971235874465080
CRE_SCHEDULE="0 */1 * * * *"
# CoinGecko demo key for the CRE workflow's price fetch (same key as COINGECKO_API_KEY). Empty works but gets 429 quickly.
CRE_COINGECKO_API_KEY=
# Hosted settler only: your ~/.cre/cre.yaml, base64-encoded, so a container with no browser can use your cre login (see scripts/settler-start.mjs). A secret: it is a full login session.
CRE_LOGIN_YAML_B64=
